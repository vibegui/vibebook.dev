{
	"compilerOptions": {
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"module": "ESNext",
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["vite/client", "node"],
		"baseUrl": ".",
		"paths": {
			"~/*": ["./src/*"]
		},
		"strictNullChecks": true
	},
	"include": ["src/**/*", "vite.config.ts", ".deco/*.ts"],
	"exclude": ["node_modules", "src/**/*.test.ts"]
}
