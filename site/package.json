{
	"name": "vibebook-site",
	"private": true,
	"type": "module",
	"description": "vibebook landing (/pt, /en) on TanStack Start + deco blocks, editable in deco Studio. The main Worker forwards those paths here.",
	"scripts": {
		"dev": "bun run generate && vite dev --port 8814",
		"generate": "bun run generate:blocks && bun run generate:sections && bun run generate:schema && tsr generate",
		"generate:blocks": "bun node_modules/@decocms/blocks-cli/scripts/generate-blocks.ts",
		"generate:sections": "bun node_modules/@decocms/blocks-cli/scripts/generate-sections.ts",
		"generate:schema": "bun node_modules/@decocms/blocks-cli/scripts/generate-schema.ts --site vibebook",
		"build": "bun run generate && vite build",
		"preview": "bun run build && wrangler dev --port 8814",
		"check": "tsc --noEmit",
		"deploy": "bun run build && wrangler deploy"
	},
	"dependencies": {
		"@decocms/blocks": "7.80.1",
		"@decocms/blocks-admin": "7.80.1",
		"@decocms/blocks-cli": "7.80.1",
		"@decocms/tanstack": "7.80.1",
		"@tanstack/react-query": "5.90.21",
		"@tanstack/react-router": "1.166.7",
		"@tanstack/react-start": "1.166.8",
		"@tanstack/react-store": "0.9.2",
		"@tanstack/store": "0.9.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.27.0",
		"@cloudflare/workers-types": "^5.20260828.1",
		"@tanstack/router-cli": "1.166.7",
		"@types/node": "22",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"babel-plugin-react-compiler": "^1.0.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"wrangler": "^4.72.0"
	}
}
