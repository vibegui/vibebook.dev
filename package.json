{
  "name": "vibebook",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/bun": "latest",
    "wrangler": "^4.152.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.153",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "scripts": {
    "dev": "bun run build:mcp && wrangler dev",
    "build:mcp": "bun scripts/build-mcp.ts",
    "deploy": "bun run build:mcp && wrangler deploy",
    "check": "tsc --noEmit && tsc --ignoreConfig --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --lib es2022,dom --skipLibCheck mcp-app/app.ts"
  }
