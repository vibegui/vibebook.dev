{
  "name": "vibebook",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@codemirror/lang-markdown": "6.3.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@7",
    "codemirror": "6.0.2",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6",
    "vite": "^8.3.8",
    "wrangler": "^4.152.0",
    "y-codemirror.next": "0.3.5",
    "y-websocket": "3.1.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.153",
    "hono": "^4.13.14",
    "y-durableobjects": "1.0.5",
    "yjs": "13.6.33",
    "zod": "^4.6.7",
    "server-only": "file:./packages/server-only"
  },
  "scripts": {
    "dev": "bun run build:ui && bun run build:mcp && wrangler dev",
    "build:mcp": "bun scripts/build-mcp.ts",
    "deploy": "bun run build:mcp && wrangler deploy",
    "check": "bun run check:backend && bun run check:ui && bun run check:protocol && bun run check:client-boundary && bun run check:bundle && bun run test:store && bun run test:ui && bun run test:build && bun run test:connection && bun run check:tooling && bun run format:check",
    "build:collab": "bun scripts/build-collab.ts",
    "build:cli": "bun build cli/vibebook.ts --outfile public/cli.mjs --target node --format esm && cp public/cli.mjs cli/cli.mjs",
    "build:ui": "vite build --config svelte/vite.config.ts",
    "check:ui": "svelte-check --tsconfig svelte/tsconfig.json",
    "test:ui": "bun test --conditions=browser scripts/ui-panels.test.ts",
    "check:client-boundary": "bun scripts/client-boundary-check.ts",
    "test:store": "bun test scripts/room-store.test.ts",
    "check:protocol": "bun scripts/protocol-check.ts",
    "test:browser": "bun scripts/browser-check.ts",
    "measure:ui": "bun scripts/ui-metrics.ts",
    "check:backend": "node node_modules/@typescript/native/bin/tsc --noEmit && node node_modules/@typescript/native/bin/tsc --ignoreConfig --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --lib es2022,dom --skipLibCheck mcp-app/app.ts && node node_modules/@typescript/native/bin/tsc --ignoreConfig --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --types node --skipLibCheck cli/vibebook.ts && bun scripts/i18n-check.ts",
    "check:bundle": "bun scripts/ui-build-check.ts",
    "test:build": "bun test scripts/ui-version.test.ts scripts/bun-client-boundary.test.ts",
    "dev:ui": "vite build --watch --config svelte/vite.config.ts",
    "test:connection": "bun test scripts/room-connection.test.ts scripts/host-lifecycle.test.ts",
    "check:tooling": "node node_modules/@typescript/native/bin/tsc -p tsconfig.tooling.json",
    "format:check": "prettier --check svelte/*.ts svelte/*.svelte svelte/build/*.ts shared/*.ts 'scripts/{browser-build,build-collab,build-mcp,bun-client-boundary.test,client-boundary-check,host-lifecycle.test,protocol-check,room-connection.test,room-store.test,ui-build-check,ui-metrics,ui-panels.test,ui-version.test,browser-check}.ts'"
  }
}
