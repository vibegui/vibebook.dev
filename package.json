{
  "name": "vibebook",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@codemirror/lang-markdown": "6.3.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/bun": "latest",
    "codemirror": "6.0.2",
    "wrangler": "^4.152.0",
    "y-codemirror.next": "0.3.5",
    "y-websocket": "3.1.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.153",
    "hono": "^4.13.14",
    "y-durableobjects": "1.0.5",
    "yjs": "13.6.33",
    "zod": "^4.6.7"
  },
  "scripts": {
    "dev": "bun run build:mcp && wrangler dev",
    "build:mcp": "bun scripts/build-mcp.ts",
    "deploy": "bun run build:mcp && wrangler deploy",
    "check": "tsc --noEmit && tsc --ignoreConfig --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --lib es2022,dom --skipLibCheck mcp-app/app.ts",
    "build:collab": "bun build collab/editor.ts --outfile public/collab.js --format esm --minify --target browser"
  }
}
