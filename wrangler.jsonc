{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibebook",
  "account_id": "55dd6d847f366735ef6e0f860c7bdc51",
  "main": "src/index.ts",
  "rules": [{ "type": "Text", "globs": ["dist-mcp/*.html"], "fallthrough": true }],
  "compatibility_date": "2026-10-01",
  // Run next to D1 (ENAM): every request does a few D1 round trips, each ~270ms from Brazil. Smart alone kept it in GIG.
  "placement": { "mode": "smart", "hint": "enam" },
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
        "run_worker_first": ["/", "/demo", "/pt", "/en", "/pt/demo", "/en/demo", "/connect", "/pt/connect", "/en/connect", "/how-it-works", "/pt/how-it-works", "/en/how-it-works", "/mcp", "/authorize", "/oauth/*", "/.well-known/*", "/api/*", "/ws/*", "/auth/*", "/app", "/archived", "/login", "/b/*", "/_site/*", "/deco/*", "/_serverFn/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "vibebook", "database_id": "8b1e10e7-ff7d-4d40-94b1-e3d9b88c4a23" }],
  "durable_objects": { "bindings": [{ "name": "BOOK", "class_name": "Book" }, { "name": "DOC_ROOMS", "class_name": "DocRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Book"] }, { "tag": "v2", "new_sqlite_classes": ["DocRoom"] }],
  "routes": [{ "pattern": "vibebook.dev", "custom_domain": true }],
  "send_email": [{ "name": "EMAIL" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "dfed86f52e7740d3bf9311b26b03ac16" }],
  // The landing, editable in deco Studio (site/). Deploy site/ first: cd site && bun run deploy.
  "services": [{ "binding": "SITE", "service": "vibebook-site" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "vibebook-files" }],
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "UPLOAD_LIMIT", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "AGENT_LIMIT", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Cost first: a cheap model routes the home box and does the background classify; Haiku writes mention emails;
    // Jev (decision model, input-only billing) grades tasks/epics and finds who is waiting on whom. No Opus/Fable.
    "MODEL_ROUTE": "deepseek/deepseek-v4.1-flash",
    "MODEL_CLASSIFY": "deepseek/deepseek-v4.1-flash",
    "MODEL_FAST": "anthropic/claude-haiku-5.5",
    "MODEL_JUDGE": "~typesafe/jev-latest",
    // MCP tool `metrics` (src/reports.ts) works only in these rooms (vibebook-growth, vibebook-product); the daily
    // posts are reminders/*.md there. CF_ANALYTICS_TOKEN is a secret (read-only analytics).
    "METRICS_ROOMS": "c635b3ffbf93,f94aedb83899",
    "CF_ACCOUNT_ID": "55dd6d847f366735ef6e0f860c7bdc51"
  },
  // No cron: removes the one the daily reports used (scheduled posts are room reminders now).
  "triggers": { "crons": [] },
  // Local dev serves as http://127.0.0.1:8797 (OAuth accepts http only on a loopback IP; :8787 is taken here).
  "dev": { "port": 8797, "host": "127.0.0.1:8797", "upstream_protocol": "http" },
  "observability": { "enabled": true }
}
