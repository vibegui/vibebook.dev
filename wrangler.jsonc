{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibebook",
  "account_id": "55dd6d847f366735ef6e0f860c7bdc51",
  "main": "src/index.ts",
  "rules": [{ "type": "Text", "globs": ["dist-mcp/*.html"], "fallthrough": true }],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
        "run_worker_first": ["/", "/mcp", "/api/*", "/ws/*", "/auth/*", "/app", "/login", "/b/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "vibebook", "database_id": "8b1e10e7-ff7d-4d40-94b1-e3d9b88c4a23" }],
  "durable_objects": { "bindings": [{ "name": "BOOK", "class_name": "Book" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Book"] }],
  "routes": [{ "pattern": "vibebook.dev", "custom_domain": true }],
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "vibebook-files" }],
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "UPLOAD_LIMIT", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "MODEL_FAST": "anthropic/claude-sonnet-5.5",
    "MODEL_MEDIUM": "anthropic/claude-opus-5.5",
    "MODEL_HEAVY": "anthropic/claude-fable-5.1",
    "MODEL_CLASSIFY": "anthropic/claude-haiku-5.5"
  },
  "observability": { "enabled": true }
}
